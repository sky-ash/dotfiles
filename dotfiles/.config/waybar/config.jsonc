//* --- waybar config --- *//

{
    "include": "~/.config/waybar/modules.jsonc",
    "reload_style_on_change": true,
    "layer": "bottom",
    //"mod": "dock",
    "exclusive": true,
    "passthrough": false,    
    "position": "top",
    //"gtk-layer-shell": true,  // is this deprecated? can't find in the wiki
    //"ipc": true,

    "spacing": 11,
    "margin-left": 5,
    "margin-right": 5,
    "margin-top": 3,
    "margin-bottom": -3,

    "modules-left": [ 
        // (power menu)
        "hyprland/workspaces",  // workspaces
        "mpris",                // music player
        "group/traymodule"            // system tray
    ],

    "modules-center": [
        "hyprland/window"       // active window's title
    ], 

    "modules-right": [
        "custom/vpn",           // custom vpn status module
        "custom/nightlight",    // custom hyprsunset module
        "hyprland/language",    // keyboard layout indicator
        "wireplumber",          // volume
        "group/weatherclock",   // clock + weather
        "custom/nc"             // notification center (swaync)
    ],
}
