//* --- waybar config --- *//

{
    "include": "~/.config/waybar/modules.jsonc",
    "reload_style_on_change": true,
    "layer": "bottom",
    //"mod": "dock",
    "exclusive": true,
    "passthrough": false,    
    "position": "top",
    //"gtk-layer-shell": true,  // is this deprecated? can't find in the wiki
    //"ipc": true,

    "spacing": 11,
    "margin-left": 7,
    "margin-right": 7,
    "margin-top": 3,
    "margin-bottom": -5,

    "modules-left": [ 
        "group/weatherclock",
        "hyprland/window",
    ],

    "modules-center": [
        "hyprland/workspaces"
    ], 

    "modules-right": [
        "wireplumber",
        "custom/vpn", 
        "custom/nc"
    ],
}
