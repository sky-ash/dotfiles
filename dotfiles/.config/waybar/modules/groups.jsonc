//* --- waybar module-groups --- *//

{

"group/weatherclock": {
    "orientation": "horizontal",
    "modules": [
        "custom/weather",
        "custom/separator#blank_2",
        "clock"
    ]
},

"group/motherboard": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "disk",
      ]	
},

"wlr/taskbar": {
    "format": "{icon} {name} ",
    "icon-size": 15,
    "all-outputs": false,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
          "wofi",
          "rofi",  
                   ]
},

}